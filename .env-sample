HOST="localhost"
PORT="8081"
RUN_BENCHMARK=0
LOGGER_SHOW_DEBUG=1

# Client health check timer (default 60)
HEALTH_CHECK_TIMER=60
PROTECTED_ROUTE_PASS=""

# First launch only
GITHUB_ID=""
GITHUB_SECRET=""

FT_ID=""
FT_SECRET=""

# Following fields must be >8 characters (first launch only)
ELASTIC_PASSWORD=""
KIBANA_PASSWORD=""
LOGSTASH_PASSWORD=""
LOGSTASH_WRITER_PASSWORD=""

# Blockchain (first launch)
AVAX_INFURA=
PRIVATE_KEY=

GRAFANA_PASSWORD=""

# Matchmaking stuff
MAX_ELO_DIFF=50 # matchmaking will forbid a match between player with elo diff greater than value (-1 == disable)

# Game Parameters
PADDLE_SPEED=3.0
BALL_SPEED=0.7
BALL_SPEED_INCREMENT=0.05
POINTS_TO_WIN=11
MAX_ANGLE=0.6

PADDLE_HEIGHT=15
PADDLE_WIDTH=1.5
PADDLE_PADDING=2
BALL_SIZE=1.5
